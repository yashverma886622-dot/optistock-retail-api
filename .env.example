# MONGODB_URI: MongoDB Atlas connection string (required for database persistence)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/optistock_retail?retryWrites=true&w=majority
MONGODB_URI=""

# MONGODB_DNS_SERVERS: optional DNS workaround for Atlas "querySrv ECONNREFUSED" errors
MONGODB_DNS_SERVERS=""

# JWT_SECRET: Cryptographically strong secret for signing JWT authentication tokens
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"

# JWT_EXPIRES_IN: Token lifetime (e.g., 7d, 24h)
JWT_EXPIRES_IN="7d"

# PORT: Server port (must be 3000 in AI Studio preview)
PORT="3000"

# NODE_ENV: development | production | test
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
